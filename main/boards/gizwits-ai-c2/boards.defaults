CONFIG_BOARD_TYPE_GIZWITS_AI_C2=y

CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_TASK_STACK_SIZE=3584

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4M.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_4M.csv"

CONFIG_ESP32C2_REV_MIN_1=y
# CONFIG_ESP32C2_REV_MIN_1_1 is not set
# CONFIG_ESP32C2_REV_MIN_200 is not set
CONFIG_ESP32C2_REV_MIN_FULL=100
CONFIG_ESP_REV_MIN_FULL=100